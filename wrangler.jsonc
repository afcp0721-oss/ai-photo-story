{
  "name": "ai-photo-story",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ai-photo-story-db",
      "database_id": "ここに自分のデータベースIDを入れる"
    }
  ]
}
